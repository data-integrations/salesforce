{
  "metadata": {
    "spec-version": "1.0"
  },
  "display-name": "Salesforce",
  "configuration-groups": [
    {
      "label": "Credentials",
      "properties": [
        {
          "widget-type" : "hidden",
          "label": "OAuth Information",
          "name": "oAuthInfo"
        },
        {
          "widget-type": "select",
          "label": "Grant Type",
          "name": "grantType",
          "widget-attributes": {
            "values": [
              "password",
              "client_credentials"
            ],
            "default": "password"
          }
        },
        {
          "widget-type": "textbox",
          "label": "User Name",
          "name": "username",
          "widget-attributes" : {
            "placeholder": "Salesforce User Name"
          }
        },
        {
          "widget-type": "password",
          "label": "Password",
          "name": "password",
          "widget-attributes" : {
            "placeholder": "Salesforce User Password"
          }
        },
        {
          "widget-type": "textbox",
          "label": "Consumer Key",
          "name": "consumerKey",
          "widget-attributes" : {
            "placeholder": "Salesforce Consumer Key"
          }
        },
        {
          "widget-type": "password",
          "label": "Consumer Secret",
          "name": "consumerSecret",
          "widget-attributes" : {
            "placeholder": "Salesforce Consumer Secret "
          }
        },
        {
          "widget-type": "password",
          "label": "Security Token",
          "name": "securityToken",
          "widget-attributes" : {
            "placeholder": "Salesforce Security token"
          }
        },
        {
          "widget-type": "textbox",
          "label": "Login Url",
          "name": "loginUrl",
          "widget-attributes" : {
            "default": "https://login.salesforce.com/services/oauth2/token"
          }
        },
        {
          "widget-type": "number",
          "label": "Connect Timeout",
          "name": "connectTimeout",
          "widget-attributes": {
            "min": "0",
            "default": "30000"
          }
        },
        {
          "widget-type": "number",
          "label": "Read Timeout(In Sec)",
          "name": "readTimeout",
          "widget-attributes": {
            "min": "0",
            "default": "3600"
          }
        },
        {
          "widget-type": "hidden",
          "label": "Initial Retry Duration",
          "name": "initialRetryDuration",
          "widget-attributes": {
            "min": "1",
            "default": "5"
          }
        },
        {
          "widget-type": "hidden",
          "label": "Max Retry Duration",
          "name": "maxRetryDuration",
          "widget-attributes": {
            "min": "6",
            "default": "80"
          }
        },
        {
          "widget-type": "hidden",
          "label": "Max Retry Count",
          "name": "maxRetryCount",
          "widget-attributes": {
            "min": "1",
            "default": "5"
          }
        },
        {
          "widget-type": "hidden",
          "label": "Retry On Backend Error",
          "name": "retryOnBackendError",
          "widget-attributes": {
            "on": {
              "value": "true",
              "label": "YES"
            },
            "off": {
              "value": "false",
              "label": "NO"
            },
            "default": "true"
          }
        }
      ]
    },
    {
      "label": "HTTP Proxy",
      "properties": [
        {
          "widget-type": "textbox",
          "label": "Proxy URL",
          "name": "proxyUrl",
          "widget-attributes" : {
            "placeholder": "Proxy URL"
          }
        }
      ]
    }
  ],
  "outputs": [],
  "filters": [
    {
      "name": "showPasswordFlowProperties",
      "condition": {
        "expression": "grantType == 'password' || grantType == ''"
      },
      "show": [
        {
          "type": "property",
          "name": "username"
        },
        {
          "type": "property",
          "name": "password"
        },
        {
          "type": "property",
          "name": "securityToken"
        }
      ]
    }
  ]
}